POSTGRES_USER: postgres
POSTGRES_PASSWORD: password
POSTGRES_DB: matchit_db

GOOGLE_CLIENT_ID=              # REST API KEY
GOOGLE_CLIENT_SECRET=          # CLIENT SECRET
GOOGLE_REDIRICT_URI=http://localhost:8000/auth/google/callback

KAKAO_CLIENT_ID=              # REST API KEY
KAKAO_CLIENT_SECRET=          # CLIENT SECRET
KAKAO_REDIRICT_URI=http://localhost:8000/auth/kakao/callback

NAVER_CLIENT_ID=              # REST API KEY
NAVER_CLIENT_SECRET=          # CLIENT SECRET
NAVER_REDIRICT_URI=http://localhost:8000/auth/naver/callback

# OpenRouter API (챗봇)
OPENROUTER_API_KEY=           # OpenRouter API 키 (https://openrouter.ai/keys 에서 발급)
OPENROUTER_MODEL=google/gemma-3-27b-it:free  # 사용할 모델 (기본값: google/gemma-3-27b-it:free)